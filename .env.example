# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

DB_URL=jdbc:mysql://localhost:3306/billing_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=replace-with-a-real-secret-minimum-32-characters-long
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8081

UTILITY_SERVICE_URL=http://localhost:8082
GROUP2_LEASE_SERVICE_URL=http://localhost:8083

CORS_ALLOWED_ORIGINS=http://localhost:3000