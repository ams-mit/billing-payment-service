# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=billing-payment-service
SERVER_PORT=8081

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3307/billing_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_password_here

# ── JWT — RS256 Keys ─────────────────────────────────────────
# Gateway public key — used to verify ALL incoming Gateway JWTs
# Put the entire key on one single line: -----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
GATEWAY_JWT_PUBLIC_KEY=your_gateway_public_key_here

# This service's RSA private key — used to sign outgoing Service JWTs
# Put the entire key on one single line: -----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
SERVICE_JWT_PRIVATE_KEY=your_service_private_key_here

# Service JWT expiry — 5 minutes per v2.1 spec
SERVICE_JWT_EXPIRES_IN=5m

# ── Inter-service Communication ───────────────────────────────────────────────
# Per v2.1: ALL inter-service calls go through the API Gateway
# Services never call each other directly
API_GATEWAY_URL=http://localhost:8080

# ── Frontend CORS ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
