# ═══════════════════════════════════════════════════════════════
# AMS Group 3 — billing-payment-service
# Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is blocked by .gitignore.
# ═══════════════════════════════════════════════════════════════

# ── Service Identity ──────────────────────────────────────────
SERVICE_NAME=billing-payment-service
SERVER_PORT=8081

# dev   → uses MockGroup2Client (no real Group 2 needed)
# prod  → uses RealGroup2Client (calls real Group 2 via Gateway)
SPRING_PROFILES_ACTIVE=dev

# ── Database ──────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3307/billing_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=

# ── JWT — RS256 Keys ──────────────────────────────────────────
# Gateway public key — verify ALL incoming Gateway JWTs (user and service type)
# Obtain from the API Gateway team (shared across all backend services)
# Format: full PEM including -----BEGIN PUBLIC KEY----- and -----END PUBLIC KEY-----
GATEWAY_JWT_PUBLIC_KEY=<paste gateway RSA public key PEM here>

# This service's RSA private key — signs outgoing Service JWTs
# when billing-payment-service calls another service through the Gateway
# Format: full PEM including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
SERVICE_JWT_PRIVATE_KEY=<paste this service RSA private key PEM here>

# Service JWT lifetime — 5 minutes per API Reference v2.1
SERVICE_JWT_EXPIRES_IN=5m

# ── Inter-Service Communication ───────────────────────────────
# Per API Reference v2.1 Section 2.1:
# ALL inter-service calls are routed through the API Gateway.
# Services never call each other directly.
API_GATEWAY_URL=http://localhost:8080

# ── Frontend CORS ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000